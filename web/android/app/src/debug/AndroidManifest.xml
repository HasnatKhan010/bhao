<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow cleartext so the app can reach a LAN API
     (http://192.168.x.x:8000) while testing without a deployed host.
     Release builds keep HTTPS-only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true">
    </application>
</manifest>
