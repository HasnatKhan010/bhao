# Bhao environment — copy to .env and adjust. Never commit .env.

# Where the data lives. Defaults to contracts/fixtures until the Phase 2 gate
# (fixture retirement), then data/.
BHAO_DATA_DIR=contracts/fixtures

# --- Track A: fetching politeness (04-DATA-SOURCES.md) ---
BHAO_RATE_LIMIT_SECONDS=2        # 1 request per 2 s, enforced by a token bucket
BHAO_USER_AGENT=bhao/0.1 (+https://github.com/hasnatkhan010/bhao) weekly-price-research
BHAO_WAYBACK_BACKOFF_BASE=5      # seconds; exponential, max 6 retries
BHAO_WAYBACK_MAX_RETRIES=6

# --- Track B: model ---
BHAO_FEATURES_VERSION=feat-v1
BHAO_BACKTEST_FOLDS=12
BHAO_RETRAIN_STALENESS_WEEKS=4   # staleness floor between retrains

# --- Track C: serve ---
BHAO_API_PORT=8000
BHAO_WEB_PORT=3000
BHAO_CACHE_TTL_SECONDS=3600
